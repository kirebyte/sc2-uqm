# EditorConfig configuration for The Ur-Quan Masters Refactored
# Ensures consistent coding styles across different editors and IDEs
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C and header files
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

# C++ files (if any)
[*.{cpp,cxx,cc,hpp,hxx}]
indent_style = space
indent_size = 4
max_line_length = 100

# Makefiles require tabs
[{Makefile,*.mk,*.make}]
indent_style = tab
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
max_line_length = 120

# Python scripts (for build tools)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# Configuration files
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

# XML files
[*.xml]
indent_style = space
indent_size = 2

# Documentation files
[*.{md,txt,rst}]
indent_style = space
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = false

# CMake files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

# Doxygen configuration
[Doxyfile*]
indent_style = space
indent_size = 2

# Git configuration
[.gitconfig]
indent_style = tab
indent_size = 4

# Package configuration
[*.{pc,pc.in}]
indent_style = space
indent_size = 2